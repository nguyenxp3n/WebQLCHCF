@model HoaDonViewModel
@{
    ViewData["Title"] = "Chi tiết Hóa Đơn " + Model.MaHD;
    var details = ViewData["Details"] as List<CTHDViewModel> ?? new List<CTHDViewModel>();
    string Money(decimal value) => value.ToString("N0") + " đ";
}

<!-- PAGE HEADER -->
<div class="page-header">
    <div class="page-title-group">
        <h2>@ViewData["Title"]</h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Tổng quan</a></li>
                <li class="breadcrumb-item"><a asp-action="Index">Hóa đơn</a></li>
                <li class="breadcrumb-item active" aria-current="page">Chi tiết</li>
            </ol>
        </nav>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="AddDetail" asp-route-maHD="@Model.MaHD" class="btn btn-primary rounded-pill px-4 hover-lift d-flex align-items-center gap-1.5">
            <i class="bi bi-plus-lg"></i> Thêm món
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
            <i class="bi bi-arrow-left"></i> Quay lại
        </a>
    </div>
</div>

<!-- INVOICE INFO CARD -->
<div class="card app-card mb-4 border-primary">
    <div class="app-card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0 fw-bold text-white"><i class="bi bi-info-circle-fill me-2"></i> Thông tin chung hóa đơn</h5>
        <span class="badge badge-success-subtle fs-6 py-1.5 px-3">Tổng cộng: @Money(Model.TongTien)</span>
    </div>
    <div class="app-card-body p-4">
        <div class="row g-3">
            <div class="col-12 col-md-3 border-end border-dashed">
                <div class="text-muted small fw-bold text-uppercase mb-1">Mã hóa đơn:</div>
                <code class="fw-bold fs-5 text-primary">@Model.MaHD</code>
            </div>
            <div class="col-12 col-md-3 border-end border-dashed">
                <div class="text-muted small fw-bold text-uppercase mb-1">Ngày lập hóa đơn:</div>
                <div class="fw-semibold"><i class="bi bi-calendar-event me-1.5 text-primary"></i>@Model.ThoiGianTao.ToString("dd/MM/yyyy HH:mm")</div>
                @if (Model.ThoiGianThanhToan.HasValue)
                {
                    <div class="small text-muted mt-1">Thanh toán: @Model.ThoiGianThanhToan.Value.ToString("dd/MM/yyyy HH:mm")</div>
                }
            </div>
            <div class="col-12 col-md-3 border-end border-dashed">
                <div class="text-muted small fw-bold text-uppercase mb-1">Nhân viên phục vụ:</div>
                <div class="fw-semibold"><i class="bi bi-person-fill-check me-1.5 text-success"></i>@Model.TenNV</div>
            </div>
            <div class="col-12 col-md-3">
                <div class="text-muted small fw-bold text-uppercase mb-1">Bàn & Khách hàng:</div>
                <div class="fw-semibold mb-1"><i class="bi bi-cup-hot me-1.5 text-warning"></i>@Model.TenBan</div>
                @if (!string.IsNullOrEmpty(Model.TenKH))
                {
                    <span class="badge badge-info-subtle"><i class="bi bi-person me-1"></i>@Model.TenKH</span>
                }
            </div>
            @if (!string.IsNullOrEmpty(Model.GhiChu))
            {
                <div class="col-12 border-top pt-3 mt-3">
                    <div class="text-muted small fw-bold text-uppercase mb-1">Ghi chú:</div>
                    <div class="bg-light rounded-3 p-2.5 border text-dark fs-7">@Model.GhiChu</div>
                </div>
            }
        </div>
    </div>
</div>

<!-- DETAILS TABLE CARD -->
<div class="card app-card">
    <div class="app-card-header bg-light">
        <h5 class="mb-0 fw-bold text-primary"><i class="bi bi-list-check me-2"></i> Chi tiết các món đã Order</h5>
    </div>
    <div class="app-card-body p-0">
        <div class="table-responsive border-0 rounded-0">
            <table class="table app-table align-middle mb-0">
                <thead>
                    <tr>
                        <th style="width: 100px;">Mã SP</th>
                        <th>Tên sản phẩm</th>
                        <th class="text-center" style="width: 100px;">Số lượng</th>
                        <th class="text-end" style="width: 130px;">Đơn giá</th>
                        <th class="text-end" style="width: 130px;">Thành tiền</th>
                        <th>Khuyến mãi áp dụng</th>
                        <th class="text-end" style="width: 180px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!details.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-folder-x fs-1 d-block mb-2"></i>
                                Hóa đơn này chưa có chi tiết mặt hàng nào!
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in details)
                        {
                            <tr>
                                <td><code>@item.MaSP</code></td>
                                <td class="fw-semibold text-primary">@item.TenSP</td>
                                <td class="text-center fw-bold text-secondary">@item.SoLuong</td>
                                <td class="text-end text-nowrap">@Money(item.DonGia)</td>
                                <td class="text-end text-nowrap fw-bold text-success">@Money(item.ThanhTien)</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.TenKM))
                                    {
                                        <span class="badge badge-danger-subtle"><i class="bi bi-tag-fill me-1"></i>@item.TenKM</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Không có</span>
                                    }
                                </td>
                                <td class="text-end text-nowrap">
                                    <div class="d-inline-flex gap-1.5">
                                        <a asp-action="EditDetail" asp-route-maHD="@item.MaHD" asp-route-maSP="@item.MaSP" class="btn btn-sm btn-outline-primary rounded-pill px-2.5 py-1" title="Sửa">
                                            <i class="bi bi-pencil-square"></i> <span class="d-none d-lg-inline">Sửa</span>
                                        </a>
                                        <a asp-action="DeleteDetail" asp-route-maHD="@item.MaHD" asp-route-maSP="@item.MaSP" class="btn btn-sm btn-outline-danger rounded-pill px-2.5 py-1" title="Xóa">
                                            <i class="bi bi-trash-fill"></i> <span class="d-none d-lg-inline">Xóa</span>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
