@model PhieuNhapViewModel
@{
    ViewData["Title"] = "Chi tiết Phiếu Nhập " + Model.MaPN;
    var details = ViewData["Details"] as List<CTPNViewModel> ?? new List<CTPNViewModel>();
    string Money(decimal value) => value.ToString("N0") + " đ";
}

<!-- PAGE HEADER -->
<div class="page-header">
    <div class="page-title-group">
        <h2>@ViewData["Title"]</h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Tổng quan</a></li>
                <li class="breadcrumb-item"><a asp-action="Index">Phiếu nhập</a></li>
                <li class="breadcrumb-item active" aria-current="page">Chi tiết</li>
            </ol>
        </nav>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="AddDetail" asp-route-maPN="@Model.MaPN" class="btn btn-primary rounded-pill px-4 hover-lift d-flex align-items-center gap-1.5">
            <i class="bi bi-plus-lg"></i> Thêm nguyên liệu
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
            <i class="bi bi-arrow-left"></i> Quay lại
        </a>
    </div>
</div>

<!-- INVOICE INFO CARD -->
<div class="card app-card mb-4 border-primary">
    <div class="app-card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0 fw-bold text-white"><i class="bi bi-info-circle-fill me-2"></i> Thông tin chung phiếu nhập</h5>
        <span class="badge badge-success-subtle fs-6 py-1.5 px-3">Tổng tiền nhập: @Money(Model.TongTien)</span>
    </div>
    <div class="app-card-body p-4">
        <div class="row g-3">
            <div class="col-12 col-md-4 border-end border-dashed">
                <div class="text-muted small fw-bold text-uppercase mb-1">Mã phiếu nhập:</div>
                <code class="fw-bold fs-5 text-primary">@Model.MaPN</code>
            </div>
            <div class="col-12 col-md-4 border-end border-dashed">
                <div class="text-muted small fw-bold text-uppercase mb-1">Ngày lập phiếu:</div>
                <div class="fw-semibold"><i class="bi bi-calendar-event me-1.5 text-primary"></i>@Model.NgayNhap.ToString("dd/MM/yyyy HH:mm")</div>
            </div>
            <div class="col-12 col-md-4">
                <div class="text-muted small fw-bold text-uppercase mb-1">Nhân viên phụ trách:</div>
                <div class="fw-semibold"><i class="bi bi-person-fill-check me-1.5 text-success"></i>@Model.TenNV</div>
            </div>
        </div>
    </div>
</div>

<!-- DETAILS TABLE CARD -->
<div class="card app-card">
    <div class="app-card-header bg-light">
        <h5 class="mb-0 fw-bold text-primary"><i class="bi bi-list-check me-2"></i> Chi tiết danh sách nguyên liệu nhập</h5>
    </div>
    <div class="app-card-body p-0">
        <div class="table-responsive border-0 rounded-0">
            <table class="table app-table align-middle mb-0">
                <thead>
                    <tr>
                        <th style="width: 100px;">Mã NL</th>
                        <th>Tên nguyên liệu</th>
                        <th class="text-center" style="width: 100px;">ĐVT</th>
                        <th class="text-center" style="width: 100px;">Số lượng</th>
                        <th class="text-end" style="width: 130px;">Đơn giá</th>
                        <th class="text-end" style="width: 130px;">Thành tiền</th>
                        <th class="text-end" style="width: 180px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!details.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-folder-x fs-1 d-block mb-2"></i>
                                Phiếu nhập này chưa có chi tiết nguyên liệu nào!
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in details)
                        {
                            <tr>
                                <td><code>@item.MaNL</code></td>
                                <td class="fw-semibold text-primary">@item.TenNL</td>
                                <td class="text-center"><span class="badge bg-light text-dark border">@item.DonViTinh</span></td>
                                <td class="text-center fw-bold text-secondary">@item.SoLuong</td>
                                <td class="text-end text-nowrap">@Money(item.DonGia)</td>
                                <td class="text-end text-nowrap fw-bold text-success">@Money(item.ThanhTien)</td>
                                <td class="text-end text-nowrap">
                                    <div class="d-inline-flex gap-1.5">
                                        <a asp-action="EditDetail" asp-route-maPN="@item.MaPN" asp-route-maNL="@item.MaNL" class="btn btn-sm btn-outline-primary rounded-pill px-2.5 py-1" title="Sửa">
                                            <i class="bi bi-pencil-square"></i> <span class="d-none d-lg-inline">Sửa</span>
                                        </a>
                                        <a asp-action="DeleteDetail" asp-route-maPN="@item.MaPN" asp-route-maNL="@item.MaNL" class="btn btn-sm btn-outline-danger rounded-pill px-2.5 py-1" title="Xóa">
                                            <i class="bi bi-trash-fill"></i> <span class="d-none d-lg-inline">Xóa</span>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
