@using Microsoft.AspNetCore.Mvc.Rendering
@model WebQLCHCF.Models.Ban

@{
    ViewData["Title"] = "Thêm bàn mới";
    var fields = ((string[])ViewData["Fields"]!).Where(f => f != "MaBan").ToArray();
    var labels = ViewData["Labels"] as Dictionary<string, string> ?? new();
    var dds = ViewData["Dropdowns"] as Dictionary<string, SelectList> ?? new();
    var ro = ViewData["ReadonlyFields"] as HashSet<string> ?? new();

    string T(string f) =>
        f.Contains("Ngay")
            ? "date"
            : f.Contains("MatKhau")
                ? "password"
                : (
                    f.Contains("SoLuong")
                    || f.Contains("Diem")
                    || f.Contains("Thang")
                    || f.Contains("Nam")
                    || f.Contains("Gia")
                    || f.Contains("Luong")
                    || f.Contains("Thuong")
                    || f.Contains("Phat")
                    || f.Contains("PhuCap")
                    || f.Contains("DinhLuong")
                )
                    ? "number"
                    : "text";

    string V(string f)
    {
        var v = Model.GetType().GetProperty(f)?.GetValue(Model);
        if (v == null)
        {
            return "";
        }
        if (v is DateTime dt)
        {
            return dt.ToString("yyyy-MM-dd");
        }
        if (v is decimal d)
        {
            return d.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
        }

        return Convert.ToString(v, System.Globalization.CultureInfo.InvariantCulture) ?? "";
    }

    string? Min(string f) => f == "DonGia" ? "1000" : null;
    string? Max(string f) => f == "DonGia" ? "10000000" : null;
    string? Step(string f) => f == "DonGia" ? "1000" : T(f) == "number" ? "0.001" : null;
}

<!-- PAGE HEADER -->
<div class="page-header">
    <div class="page-title-group">
        <h2>@ViewData["Title"]</h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Tổng quan</a></li>
                <li class="breadcrumb-item"><a asp-action="Index">Danh sách Bàn</a></li>
                <li class="breadcrumb-item active" aria-current="page">Thêm mới</li>
            </ol>
        </nav>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
        <i class="bi bi-arrow-left"></i> Quay lại
    </a>
</div>

<div class="card app-card form-card">
    <div class="app-card-header bg-primary text-white">
        <h5 class="mb-0 fw-bold text-white"><i class="bi bi-plus-circle-fill me-2"></i> Nhập thông tin bàn phục vụ</h5>
    </div>
    <div class="app-card-body p-4">
        <div class="mb-4 bg-light rounded-3 p-3 border">
            <div class="form-text text-muted"><i class="bi bi-info-circle-fill"></i> Hệ thống tự sinh mã bàn, số bàn và tên bàn theo khu vực khi lưu.</div>
        </div>

        <form method="post" class="needs-validation" novalidate data-pjax-form="true">
            @Html.AntiForgeryToken()
            
            @if (!ViewData.ModelState.IsValid)
            {
                <div asp-validation-summary="All" class="alert alert-danger border-0 rounded-3 mb-4 small"></div>
            }

            <div class="row g-3">
                @foreach (var f in fields)
                {
                    <div class="col-12 col-md-6 app-form-group">
                        <label class="form-label fw-semibold" for="@f">
                            @(labels.ContainsKey(f) ? labels[f] : f)
                        </label>
                        @if (dds.ContainsKey(f))
                        {
                            <div class="input-group">
                                <span class="input-group-text bg-white text-muted"><i class="bi bi-box-arrow-in-right"></i></span>
                                <select class="form-select" id="@f" name="@f">
                                    @foreach (var option in dds[f])
                                    {
                                        var optionValue = option.Value ?? option.Text;
                                        <option value="@optionValue" selected="@(optionValue == V(f) ? "selected" : null)">@option.Text</option>
                                    }
                                </select>
                            </div>
                        }
                        else
                        {
                            <input class="form-control" id="@f" name="@f" type="@T(f)" value="@V(f)" min="@Min(f)" max="@Max(f)" step="@Step(f)" readonly="@(ro.Contains(f) ? "readonly" : null)" />
                        }
                        <span class="text-danger small mt-1 d-block field-validation-valid" data-valmsg-for="@f" data-valmsg-replace="true"></span>
                    </div>
                }
            </div>

            <!-- ACTION BUTTONS -->
            <div class="mt-4 pt-3 border-top d-flex gap-2">
                <button class="btn btn-primary rounded-pill px-5 hover-lift" type="submit">
                    <i class="bi bi-save me-1"></i> Lưu bàn
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Hủy bỏ</a>
            </div>
        </form>
    </div>
</div>
