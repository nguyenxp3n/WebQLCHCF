@model WebQLCHCF.ViewModels.CongThucIndexItemViewModel

@{
    ViewData["Title"] = "Chi tiết Công Thức Pha Chế";
}

<div class="page-header">
    <div class="page-title-group">
        <h2>@ViewData["Title"]</h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Tổng quan</a></li>
                <li class="breadcrumb-item"><a asp-action="Index">Công thức pha chế</a></li>
                <li class="breadcrumb-item active" aria-current="page">Chi tiết</li>
            </ol>
        </nav>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-maSP="@Model.MaSP" class="btn btn-primary rounded-pill px-4">
            <i class="bi bi-pencil-square"></i> Sửa công thức
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
            <i class="bi bi-arrow-left"></i> Quay lại
        </a>
    </div>
</div>

<div class="card app-card">
    <div class="app-card-header">
        <h5 class="mb-0 fw-bold text-primary"><code>@Model.MaSP</code> - @Model.TenSP</h5>
    </div>
    <div class="app-card-body p-0">
        <div class="table-responsive">
            <table class="table app-table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Mã NL</th>
                        <th>Tên nguyên liệu</th>
                        <th>Đơn vị</th>
                        <th>Định lượng</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.NguyenLieus)
                    {
                        <tr>
                            <td><code class="fw-bold">@item.MaNL</code></td>
                            <td>@item.TenNL</td>
                            <td>@item.DonViTinh</td>
                            <td><strong>@item.DinhLuong.ToString("0.###") @item.DonViTinh</strong></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
