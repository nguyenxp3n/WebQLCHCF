@model WebQLCHCF.ViewModels.SanPhamIndexViewModel

@{
    ViewData["Title"] = "Quản lý sản phẩm";
    var cols = (string[])ViewData["Columns"]!;
    var labels = ViewData["Labels"] as Dictionary<string, string> ?? new();
    var keys = (string[])ViewData["KeyNames"]!;
    var currentListUrl = ViewBag.CurrentListUrl as string ?? Url.Action("Index") ?? "/SanPham";

    string F(object? v, string n)
    {
        if (v == null)
        {
            return "";
        }
        if (v is DateTime d)
        {
            return d.ToString("dd/MM/yyyy");
        }
        if (v is decimal m && (n.Contains("Tien") || n.Contains("Gia") || n.Contains("Luong")))
        {
            return m.ToString("N0") + " đ";
        }

        return v.ToString() ?? "";
    }

    string GetBadgeClass(string value)
    {
        return value switch
        {
            "Đang bán" or "Sẵn sàng" => "badge-success-subtle",
            "Tạm ngưng" or "Cảnh báo" => "badge-warning-subtle",
            "Ngừng bán" => "badge-primary-subtle",
            "Khóa" or "Hủy" or "Đã xóa" => "badge-danger-subtle",
            _ => "badge-info-subtle"
        };
    }

    IDictionary<string, string> R(object item)
    {
        var r = new Dictionary<string, string>();
        if (keys.Length == 1)
        {
            r["id"] = Convert.ToString(item.GetType().GetProperty(keys[0])?.GetValue(item)) ?? "";
        }
        else
        {
            foreach (var k in keys)
            {
                r[char.ToLowerInvariant(k[0]) + k[1..]] = Convert.ToString(item.GetType().GetProperty(k)?.GetValue(item)) ?? "";
            }
        }

        return r;
    }

    IDictionary<string, string> RouteWithReturn(object item)
    {
        var route = R(item);
        route["returnUrl"] = currentListUrl;
        return route;
    }
}

<!-- PAGE HEADER -->
<div class="page-header">
    <div class="page-title-group">
        <h2>@ViewData["Title"]</h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Tổng quan</a></li>
                <li class="breadcrumb-item active" aria-current="page">Sản phẩm</li>
            </ol>
        </nav>
    </div>
    <a asp-action="Create" class="btn btn-primary rounded-pill px-4 d-flex align-items-center gap-2 hover-lift">
        <i class="bi bi-plus-lg"></i>
        <span>Thêm sản phẩm mới</span>
    </a>
</div>

<!-- PRODUCT FILTERS -->
<div class="card app-card product-filter-card mb-4">
    <div class="app-card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
        <h5 class="mb-0 fw-bold text-primary">
            <i class="bi bi-funnel-fill me-2"></i>Bộ lọc sản phẩm
        </h5>
        @if (Model.HasFilter)
        {
            <span class="badge badge-info-subtle py-2 px-3">
                Đang lọc: @Model.SoKetQua / @Model.TongSo sản phẩm
            </span>
        }
        else
        {
            <span class="badge badge-primary-subtle py-2 px-3">
                Tổng số: @Model.TongSo sản phẩm
            </span>
        }
    </div>
    <div class="app-card-body">
        <form method="get" asp-action="Index" class="row g-3 align-items-end">
            <div class="col-12 col-lg-4">
                <label for="tuKhoa" class="form-label fw-semibold">Tìm kiếm</label>
                <div class="input-group">
                    <span class="input-group-text bg-white text-muted"><i class="bi bi-search"></i></span>
                    <input id="tuKhoa"
                           name="tuKhoa"
                           class="form-control"
                           value="@Model.TuKhoa"
                           placeholder="Nhập mã SP hoặc tên sản phẩm..." />
                </div>
            </div>
            <div class="col-12 col-md-6 col-lg-3">
                <label for="maLoaiSP" class="form-label fw-semibold">Loại sản phẩm</label>
                <select id="maLoaiSP" name="maLoaiSP" class="form-select">
                    <option value="">Tất cả loại sản phẩm</option>
                    @foreach (var category in Model.LoaiSanPhams)
                    {
                        <option value="@category.MaLoaiSP" selected="@(category.MaLoaiSP == Model.MaLoaiSP)">
                            @category.TenLoaiSP
                        </option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-6 col-lg-3">
                <label for="trangThai" class="form-label fw-semibold">Trạng thái</label>
                <select id="trangThai" name="trangThai" class="form-select">
                    <option value="">Tất cả trạng thái</option>
                    @foreach (var status in Model.TrangThaiOptions)
                    {
                        <option value="@status" selected="@(status == Model.TrangThai)">
                            @status
                        </option>
                    }
                </select>
            </div>
            <div class="col-12 col-lg-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-fill rounded-pill">
                    <i class="bi bi-funnel me-1"></i>Lọc
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill" title="Xóa lọc">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- PREMIUM TABLE CARD -->
<div class="card app-card">
    <div class="app-card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0 fw-bold text-primary"><i class="bi bi-list-stars me-2"></i> Danh sách mặt hàng</h5>
        <span class="badge badge-primary-subtle py-2 px-3">Hiển thị: @Model.SoKetQua sản phẩm</span>
    </div>
    <div class="app-card-body p-0">
        <div class="table-responsive border-0 rounded-0">
            <table class="table app-table product-table align-middle mb-0">
                <thead>
                    <tr>
                        @foreach (var c in cols)
                        {
                            <th>@(labels.ContainsKey(c) ? labels[c] : c)</th>
                        }
                        <th class="text-end" style="width: 220px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Items.Any())
                    {
                        <tr>
                            <td colspan="@(cols.Length + 1)" class="text-center py-5 text-muted">
                                <i class="bi bi-folder-x fs-1 d-block mb-2"></i>
                                Không tìm thấy sản phẩm phù hợp bộ lọc.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                @foreach (var c in cols)
                                {
                                    var value = F(item.GetType().GetProperty(c)?.GetValue(item), c);
                                    <td class="@(c == "TenSP" ? "product-name-cell" : c == "TenLoaiSP" ? "product-category-cell" : null)">
                                        @if (c == "TrangThai" || c == "TinhTrang")
                                        {
                                            <span class="badge @GetBadgeClass(value)">@value</span>
                                        }
                                        else if (c == "MaSP" || c == "MaLoaiSP")
                                        {
                                            <code class="fw-bold">@value</code>
                                        }
                                        else
                                        {
                                            @value
                                        }
                                    </td>
                                }
                                <td class="text-end text-nowrap">
                                    <div class="d-inline-flex gap-1.5">
                                        <a asp-action="Details" asp-all-route-data="RouteWithReturn(item)" class="btn btn-sm btn-outline-secondary rounded-pill px-2.5 py-1" title="Chi tiết">
                                            <i class="bi bi-eye-fill"></i> <span class="d-none d-xl-inline">Chi tiết</span>
                                        </a>
                                        <a asp-action="Edit" asp-all-route-data="RouteWithReturn(item)" class="btn btn-sm btn-outline-primary rounded-pill px-2.5 py-1" title="Sửa">
                                            <i class="bi bi-pencil-square"></i> <span class="d-none d-xl-inline">Sửa</span>
                                        </a>
                                        <a asp-action="Delete" asp-all-route-data="RouteWithReturn(item)" class="btn btn-sm btn-outline-danger rounded-pill px-2.5 py-1" title="Xóa">
                                            <i class="bi bi-trash-fill"></i> <span class="d-none d-xl-inline">Xóa</span>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

