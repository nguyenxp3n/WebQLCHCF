@using System.Globalization
@model LuongThangViewModel

@{
    ViewData["Title"] = "Lương tháng " + Model.Thang;
    var culture = CultureInfo.GetCultureInfo("vi-VN");
    var tongQuan = Model.TongQuan;

    string Money(decimal value) => value.ToString("N0", culture) + " đ";
}

<!-- PAGE HEADER -->
<div class="page-header">
    <div class="page-title-group">
        <h2>@ViewData["Title"]</h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Tổng quan</a></li>
                <li class="breadcrumb-item"><a asp-action="Index">Lương nhân viên</a></li>
                <li class="breadcrumb-item active" aria-current="page">Lương tháng</li>
            </ol>
        </nav>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
        <i class="bi bi-arrow-left"></i> Quay lại
    </a>
</div>

<!-- MONTH SELECTOR FORM -->
<div class="card app-card mb-4">
    <div class="app-card-body p-3">
        <form asp-action="Thang" method="get" class="row g-3 align-items-center">
            <div class="col-12 col-md-4 col-lg-3 d-flex align-items-center gap-2">
                <label for="thang" class="form-label mb-0 fw-semibold text-nowrap"><i class="bi bi-calendar-check text-primary me-1"></i> Chọn tháng:</label>
                <select id="thang" name="thang" class="form-select rounded-pill">
                    @for (var i = 1; i <= 12; i++)
                    {
                        <!option value="@i" @(i == Model.Thang ? "selected" : "")>Tháng @i</!option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-3">
                <button type="submit" class="btn btn-primary rounded-pill px-4 hover-lift w-100 w-md-auto">
                    <i class="bi bi-search me-1"></i> Xem lương tháng
                </button>
            </div>
        </form>
    </div>
</div>

<!-- METRICS CARDS -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card metric-card primary h-100">
            <div class="card-body">
                <div class="metric-icon"><i class="bi bi-calendar3-range"></i></div>
                <div class="metric-label">Tổng số ca</div>
                <div class="metric-value">@(tongQuan?.TongSoCaLam ?? 0)</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card metric-card success h-100">
            <div class="card-body">
                <div class="metric-icon"><i class="bi bi-people"></i></div>
                <div class="metric-label">Nhân viên đi làm</div>
                <div class="metric-value">@(tongQuan?.TongNhanVienCoLam ?? 0)</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card metric-card warning h-100">
            <div class="card-body">
                <div class="metric-icon"><i class="bi bi-clock"></i></div>
                <div class="metric-label">Tổng giờ công</div>
                <div class="metric-value">@((tongQuan?.TongGio ?? 0).ToString("N1", culture)) <span class="fs-6 text-muted">giờ</span></div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card metric-card info h-100">
            <div class="card-body">
                <div class="metric-icon"><i class="bi bi-wallet2"></i></div>
                <div class="metric-label">Tổng chi lương</div>
                <div class="metric-value text-success fs-4">@Money(tongQuan?.TongLuongPhaiChuyen ?? 0)</div>
            </div>
        </div>
    </div>
</div>

<div class="alert alert-info border-0 rounded-3 mb-4 d-flex align-items-center gap-2.5">
    <i class="bi bi-info-circle-fill fs-5 text-info"></i>
    <div>
        <strong>Cách tính lương:</strong> Tổng lương = Tổng giờ tháng × Lương theo giờ hiện tại của nhân viên. Hệ thống chỉ tổng hợp đối với các ca làm việc đã hoàn thành check-out.
    </div>
</div>

<!-- SUMMARY BY EMPLOYEE -->
<div class="card app-card mb-4">
    <div class="app-card-header bg-light">
        <h5 class="mb-0 fw-bold text-primary"><i class="bi bi-table me-2"></i> Tổng hợp lương theo nhân viên</h5>
    </div>
    <div class="app-card-body p-0">
        <div class="table-responsive">
            <table class="table app-table align-middle mb-0">
                <thead>
                    <tr>
                        <th style="width: 100px;">Mã NV</th>
                        <th>Họ và tên</th>
                        <th>Chức vụ</th>
                        <th class="text-end">Lương/giờ</th>
                        <th class="text-center" style="width: 100px;">Số ca</th>
                        <th class="text-end">Tổng giờ</th>
                        <th class="text-end">Thành tiền</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.LuongNhanVien.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-person-x fs-1 d-block mb-2 text-secondary"></i>
                                Không có dữ liệu làm việc của nhân viên trong tháng này!
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.LuongNhanVien)
                        {
                            <tr>
                                <td><code>@item.MaNV</code></td>
                                <td class="fw-semibold text-primary">@item.TenNV</td>
                                <td><span class="badge bg-light text-dark border">@item.ChucVu</span></td>
                                <td class="text-end text-nowrap">@Money(item.LuongTheoGio)</td>
                                <td class="text-center fw-bold text-secondary">@item.SoCaLam</td>
                                <td class="text-end fw-semibold">@item.TongGio.ToString("N1", culture) giờ</td>
                                <td class="text-end text-nowrap fw-bold text-success">@Money(item.TongLuong)</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- DETAILED SHIFTS -->
<div class="card app-card">
    <div class="app-card-header bg-light">
        <h5 class="mb-0 fw-bold text-primary"><i class="bi bi-clock-history me-2"></i> Nhật ký chi tiết ca làm đã check-out</h5>
    </div>
    <div class="app-card-body p-0">
        <div class="table-responsive">
            <table class="table app-table align-middle mb-0">
                <thead>
                    <tr>
                        <th style="width: 100px;">Mã ca</th>
                        <th>Họ và tên nhân viên</th>
                        <th>Giờ Check-in</th>
                        <th>Giờ Check-out</th>
                        <th class="text-end">Tổng giờ</th>
                        <th class="text-end">Tiền công ca</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.CaLam.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-calendar-x fs-1 d-block mb-2 text-secondary"></i>
                                Không tìm thấy ca làm việc nào đã check-out trong tháng này!
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.CaLam)
                        {
                            <tr>
                                <td><code>@item.MaCC</code></td>
                                <td class="fw-semibold text-primary">@item.TenNV</td>
                                <td><i class="bi bi-box-arrow-in-right text-success me-1"></i>@item.ThoiGianCheckIn.ToString("HH:mm dd/MM/yyyy")</td>
                                <td><i class="bi bi-box-arrow-left text-danger me-1"></i>@item.ThoiGianCheckOut?.ToString("HH:mm dd/MM/yyyy")</td>
                                <td class="text-end fw-semibold text-secondary">@item.TongGio.ToString("N2", culture) giờ</td>
                                <td class="text-end text-nowrap fw-bold text-success">@Money(item.TienCongTheoCa)</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
