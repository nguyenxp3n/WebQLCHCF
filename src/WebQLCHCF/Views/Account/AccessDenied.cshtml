@{
    ViewData["Title"] = "Không có quyền truy cập";
}

<div class="page-header justify-content-center">
    <div class="text-center">
        <h2>@ViewData["Title"]</h2>
        <p class="text-muted mb-0">Bạn không có quyền truy cập chức năng này.</p>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="card app-card border-warning shadow-sm">
            <div class="app-card-body p-4 text-center">
                <div class="display-5 text-warning mb-3">
                    <i class="bi bi-shield-exclamation"></i>
                </div>
                <h5 class="fw-bold text-primary mb-2">Bạn không có quyền truy cập chức năng này.</h5>
                <p class="text-muted mb-4">Vui lòng dùng tài khoản có quyền phù hợp hoặc quay lại màn hình làm việc được cấp quyền.</p>
                <div class="d-flex flex-wrap justify-content-center gap-2">
                    <a asp-controller="Order" asp-action="Create" class="btn btn-primary rounded-pill px-4">
                        <i class="bi bi-cup-hot me-1"></i> Về Order
                    </a>
                    <a asp-controller="Account" asp-action="Logout" class="btn btn-outline-secondary rounded-pill px-4" data-no-pjax="true">
                        <i class="bi bi-box-arrow-right me-1"></i> Đăng xuất
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
