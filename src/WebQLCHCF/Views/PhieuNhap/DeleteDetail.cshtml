@model object

@{
    var cols = (string[])ViewData["Columns"]!;
    var labels = ViewData["Labels"] as Dictionary<string, string> ?? new();

    string F(object? v, string n)
    {
        if (v == null)
        {
            return "";
        }
        if (v is DateTime d)
        {
            return d.ToString("dd/MM/yyyy HH:mm");
        }
        if (v is decimal m && (n.Contains("Tien") || n.Contains("Gia") || n.Contains("Luong")))
        {
            return m.ToString("N0") + " đ";
        }

        return v.ToString() ?? "";
    }
}

<!-- PAGE HEADER -->
<div class="page-header">
    <div class="page-title-group">
        <h2>@ViewData["Title"]</h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Tổng quan</a></li>
                <li class="breadcrumb-item"><a asp-action="Index">Phiếu nhập</a></li>
                <li class="breadcrumb-item active" aria-current="page">Xóa nguyên liệu nhập</li>
            </ol>
        </nav>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
        <i class="bi bi-arrow-left"></i> Quay lại
    </a>
</div>

<div class="card app-card border-danger mb-4">
    <div class="app-card-header bg-danger text-white">
        <h5 class="mb-0 fw-bold text-white"><i class="bi bi-exclamation-triangle-fill me-2"></i> Xác nhận xóa nguyên liệu nhập</h5>
    </div>
    <div class="app-card-body p-4">
        <div class="alert alert-danger border-0 rounded-3 mb-4 d-flex align-items-center gap-3">
            <i class="bi bi-shield-fill-x fs-3 text-danger"></i>
            <div>
                <strong>Cảnh báo quan trọng:</strong> Hành động này sẽ loại bỏ dòng nhập nguyên liệu này khỏi phiếu nhập và giảm số lượng tồn kho tương ứng. Vui lòng kiểm tra kỹ trước khi xóa.
            </div>
        </div>

        <div class="bg-light rounded-3 p-3 border mb-4">
            <h6 class="fw-bold text-primary mb-3"><i class="bi bi-info-circle-fill me-1"></i> Chi tiết dòng nguyên liệu cần xóa:</h6>
            <dl class="row mb-0 g-2">
                @foreach (var c in cols)
                {
                    <dt class="col-sm-4 text-muted small fw-bold text-uppercase">@(labels.ContainsKey(c) ? labels[c] : c)</dt>
                    <dd class="col-sm-8 fw-semibold text-dark">@F(Model.GetType().GetProperty(c)?.GetValue(Model), c)</dd>
                }
            </dl>
        </div>

        <form method="post" onsubmit="return confirm('Bạn chắc chắn muốn xóa nguyên liệu nhập này khỏi phiếu nhập?');" class="d-flex gap-2">
            @Html.AntiForgeryToken()
            <button class="btn btn-danger rounded-pill px-5 hover-lift" type="submit">
                <i class="bi bi-trash3-fill me-1"></i> Xác nhận xóa
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Hủy bỏ</a>
        </form>
    </div>
</div>
