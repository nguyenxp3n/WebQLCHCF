@using WebQLCHCF.Services
@model IEnumerable<object>

@{
    ViewData["Title"] = "Quản lý Hóa Đơn";
    var cols = (string[])ViewData["Columns"]!;
    var keys = (string[])ViewData["KeyNames"]!;

    object? P(object item, string name)
    {
        return item.GetType().GetProperty(name)?.GetValue(item);
    }

    string S(object item, string name)
    {
        return Convert.ToString(P(item, name)) ?? "";
    }

    DateTime? D(object item, string name)
    {
        var value = P(item, name);
        return value is DateTime date ? date : null;
    }

    string F(object? v, string n)
    {
        if (v == null)
        {
            return "";
        }
        if (v is DateTime d)
        {
            return d.ToString("dd/MM/yyyy HH:mm");
        }
        if (v is decimal m && (n.Contains("Tien") || n.Contains("Gia") || n.Contains("Luong")))
        {
            return m.ToString("N0") + " đ";
        }

        return v.ToString() ?? "";
    }

    string LabelFor(string column)
    {
        return column switch
        {
            "MaHD" => "Mã HĐ",
            "ThoiGianTao" => "Ngày lập",
            "NgayLap" => "Ngày lập",
            "TenNV" => "Tên NV",
            "TenKH" => "Tên KH",
            "TenBan" => "Tên bàn",
            "TongTien" => "Tổng tiền",
            "TrangThaiThanhToanHienThi" => "Trạng thái thanh toán",
            "GhiChu" => "Ghi chú",
            _ => column
        };
    }

    string GetBadgeClass(string value)
    {
        return value switch
        {
            "Đang bán" or "Sẵn sàng" or "Đã thanh toán" or "Hoàn thành" => "badge-success-subtle",
            "Tạm ngưng" or "Cảnh báo" or "Chưa thanh toán" or "Chờ phục vụ" => "badge-warning-subtle",
            "Ngừng bán" => "badge-primary-subtle",
            "Khóa" or "Hủy" or "Đã xóa" or "Đã hủy" => "badge-danger-subtle",
            _ => "badge-info-subtle"
        };
    }

    string PaymentMethodLabel(string? method)
    {
        return method switch
        {
            OrderWorkflowConstants.PhuongThucTienMat => "tiền mặt",
            OrderWorkflowConstants.PhuongThucQr => "QR",
            _ => "khác"
        };
    }

    string FormatRemaining(DateTime expiresAt)
    {
        var remaining = expiresAt - DateTime.Now;
        if (remaining <= TimeSpan.Zero)
        {
            return "QR hết hạn";
        }

        return $"Còn {(int)remaining.TotalMinutes:00}:{remaining.Seconds:00}";
    }

    bool IsQrExpired(object item)
    {
        var paymentStatus = S(item, "TrangThaiThanhToanGanNhat");
        var invoiceStatus = S(item, "TrangThaiThanhToan");
        var expiresAt = D(item, "ThoiGianHetHanQr");

        return invoiceStatus == OrderWorkflowConstants.TrangThaiThanhToanHetHan
            || paymentStatus == OrderWorkflowConstants.TrangThaiThanhToanHetHan
            || (
                (invoiceStatus == OrderWorkflowConstants.TrangThaiThanhToanChoThanhToanQr
                    || paymentStatus == OrderWorkflowConstants.TrangThaiThanhToanChoThanhToanQr)
                && expiresAt.HasValue
                && expiresAt.Value <= DateTime.Now
            );
    }

    IDictionary<string, string> R(object item)
    {
        var r = new Dictionary<string, string>();
        if (keys.Length == 1)
        {
            r["id"] = Convert.ToString(P(item, keys[0])) ?? "";
        }
        else
        {
            foreach (var k in keys)
            {
                r[char.ToLowerInvariant(k[0]) + k[1..]] = Convert.ToString(P(item, k)) ?? "";
            }
        }

        return r;
    }
}

<div class="page-header">
    <div class="page-title-group">
        <h2>@ViewData["Title"]</h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Tổng quan</a></li>
                <li class="breadcrumb-item active" aria-current="page">Hóa đơn</li>
            </ol>
        </nav>
    </div>
    <a asp-controller="Order" asp-action="Create" class="btn btn-primary rounded-pill px-4 d-flex align-items-center gap-2 hover-lift">
        <i class="bi bi-cart-plus-fill"></i>
        <span>Tạo order mới (Tại quầy)</span>
    </a>
</div>

<div class="card app-card">
    <div class="app-card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0 fw-bold text-primary"><i class="bi bi-receipt-cutoff me-2"></i> Lịch sử giao dịch hóa đơn</h5>
        <span class="badge badge-primary-subtle py-2 px-3">Tổng số: @Model.Count() hóa đơn</span>
    </div>
    <div class="app-card-body p-0">
        <div class="table-responsive border-0 rounded-0">
            <table class="table app-table align-middle mb-0">
                <thead>
                    <tr>
                        @foreach (var c in cols)
                        {
                            <th>@LabelFor(c)</th>
                        }
                        <th class="text-end" style="width: 220px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="@(cols.Length + 1)" class="text-center py-5 text-muted">
                                <i class="bi bi-folder-x fs-1 d-block mb-2"></i>
                                Không tìm thấy hóa đơn nào trong hệ thống!
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            var invoicePaymentStatus = S(item, "TrangThaiThanhToan");
                            var latestPaymentStatus = S(item, "TrangThaiThanhToanGanNhat");
                            var paymentMethod = S(item, "PhuongThucThanhToan");
                            var latestPaymentMethod = S(item, "PhuongThucThanhToanGanNhat");
                            var effectiveMethod = !string.IsNullOrWhiteSpace(paymentMethod) ? paymentMethod : latestPaymentMethod;
                            var paidAt = D(item, "ThoiGianThanhToan");
                            var expiresAt = D(item, "ThoiGianHetHanQr");
                            var isPaid = invoicePaymentStatus == OrderWorkflowConstants.TrangThaiThanhToanDaThanhToan;
                            var isReview = invoicePaymentStatus == OrderWorkflowConstants.TrangThaiThanhToanChoKiemTra
                                || latestPaymentStatus == OrderWorkflowConstants.TrangThaiThanhToanChoKiemTra;
                            var isExpired = IsQrExpired(item);
                            var isCanceled = invoicePaymentStatus == OrderWorkflowConstants.TrangThaiThanhToanDaHuy
                                || S(item, "TrangThaiOrder") == OrderWorkflowConstants.TrangThaiOrderDaHuy;
                            var isWaitingQr = !isPaid
                                && !isExpired
                                && !isCanceled
                                && (invoicePaymentStatus == OrderWorkflowConstants.TrangThaiThanhToanChoThanhToanQr
                                    || latestPaymentStatus == OrderWorkflowConstants.TrangThaiThanhToanChoThanhToanQr);
                            var note = S(item, "GhiChu");

                            <tr>
                                @foreach (var c in cols)
                                {
                                    <td>
                                        @if (c == "TrangThaiThanhToanHienThi")
                                        {
                                            <div class="invoice-payment-status">
                                                @if (isPaid)
                                                {
                                                    <span class="invoice-payment-badge invoice-payment-paid">
                                                        <i class="bi bi-check-circle-fill"></i>
                                                        Đã thanh toán @PaymentMethodLabel(effectiveMethod)
                                                    </span>
                                                    @if (paidAt.HasValue)
                                                    {
                                                        <small>Thanh toán: @paidAt.Value.ToString("dd/MM/yyyy HH:mm")</small>
                                                    }
                                                }
                                                else if (isReview)
                                                {
                                                    <span class="invoice-payment-badge invoice-payment-review">
                                                        <i class="bi bi-exclamation-triangle-fill"></i>
                                                        Chờ kiểm tra
                                                    </span>
                                                }
                                                else if (isExpired)
                                                {
                                                    <span class="invoice-payment-badge invoice-payment-expired">
                                                        <i class="bi bi-clock-history"></i>
                                                        QR hết hạn
                                                    </span>
                                                }
                                                else if (isCanceled)
                                                {
                                                    <span class="invoice-payment-badge invoice-payment-canceled">
                                                        <i class="bi bi-x-circle-fill"></i>
                                                        Đã hủy
                                                    </span>
                                                    @if (!string.IsNullOrWhiteSpace(note))
                                                    {
                                                        <button type="button" class="btn btn-link btn-sm p-0 invoice-cancel-reason" data-bs-toggle="tooltip" title="@note">Xem lý do</button>
                                                    }
                                                }
                                                else if (isWaitingQr)
                                                {
                                                    <span class="invoice-payment-badge invoice-payment-waiting">
                                                        <i class="bi bi-hourglass-split"></i>
                                                        Chờ thanh toán QR
                                                    </span>
                                                    @if (expiresAt.HasValue)
                                                    {
                                                        var remainingClass = expiresAt.Value - DateTime.Now <= TimeSpan.FromMinutes(2) ? " is-urgent" : "";
                                                        <small class="invoice-payment-countdown@remainingClass" data-expire-at="@expiresAt.Value.ToString("O")">@FormatRemaining(expiresAt.Value)</small>
                                                    }
                                                }
                                                else
                                                {
                                                    <span class="invoice-payment-badge invoice-payment-unpaid">
                                                        <i class="bi bi-circle-fill"></i>
                                                        Chưa thanh toán
                                                    </span>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            var value = F(P(item, c), c);
                                            if (c == "TrangThai" || c == "TinhTrang" || c == "TrangThaiHD")
                                            {
                                                <span class="badge @GetBadgeClass(value)">@value</span>
                                            }
                                            else if (c == "MaHD")
                                            {
                                                <code class="fw-bold">@value</code>
                                            }
                                            else if (c == "TongTien" || c == "ThanhTien")
                                            {
                                                <span class="fw-bold text-success">@value</span>
                                            }
                                            else
                                            {
                                                @value
                                            }
                                        }
                                    </td>
                                }
                                <td class="text-end text-nowrap">
                                    <div class="d-inline-flex gap-1.5">
                                        <a asp-action="Details" asp-all-route-data="R(item)" class="btn btn-sm btn-outline-secondary rounded-pill px-2.5 py-1" title="Chi tiết">
                                            <i class="bi bi-eye-fill"></i> <span class="d-none d-xl-inline">Chi tiết</span>
                                        </a>
                                        <a asp-action="Edit" asp-all-route-data="R(item)" class="btn btn-sm btn-outline-primary rounded-pill px-2.5 py-1" title="Sửa">
                                            <i class="bi bi-pencil-square"></i> <span class="d-none d-xl-inline">Sửa</span>
                                        </a>
                                        @if (isPaid)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-2.5 py-1 disabled" disabled data-bs-toggle="tooltip" title="Hóa đơn đã thanh toán nên không thể xóa.">
                                                <i class="bi bi-trash-fill"></i> <span class="d-none d-xl-inline">Xóa</span>
                                            </button>
                                        }
                                        else
                                        {
                                            <a asp-action="Delete" asp-all-route-data="R(item)" class="btn btn-sm btn-outline-danger rounded-pill px-2.5 py-1" title="Xóa">
                                                <i class="bi bi-trash-fill"></i> <span class="d-none d-xl-inline">Xóa</span>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
