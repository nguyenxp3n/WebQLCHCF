@using WebQLCHCF.Models
@model WebQLCHCF.ViewModels.CongThucEditorViewModel

@{
    var products = ViewBag.SanPhams as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
    var ingredients = ViewBag.NguyenLieus as List<NguyenLieu> ?? new();
    var isEditing = ViewData["IsEditing"] as bool? ?? false;
    var submitLabel = ViewData["SubmitLabel"]?.ToString() ?? "Lưu công thức";
    if (Model.Items.Count == 0 && Model.NguyenLieus.Count > 0)
    {
        Model.Items = Model.NguyenLieus;
    }
}

<div class="page-header">
    <div class="page-title-group">
        <h2>@ViewData["Title"]</h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Tổng quan</a></li>
                <li class="breadcrumb-item"><a asp-action="Index">Công thức pha chế</a></li>
                <li class="breadcrumb-item active" aria-current="page">@(isEditing ? "Chỉnh sửa" : "Thêm mới")</li>
            </ol>
        </nav>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
        <i class="bi bi-arrow-left"></i> Quay lại
    </a>
</div>

<div class="card app-card form-card">
    <div class="app-card-header bg-primary text-white">
        <h5 class="mb-0 fw-bold text-white"><i class="bi bi-cup-hot-fill me-2"></i> Thiết lập nguyên liệu pha chế</h5>
    </div>
    <div class="app-card-body p-4">
        <form method="post" class="needs-validation recipe-editor" novalidate data-no-pjax="true">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="All" class="alert alert-danger border-0 rounded-3 mb-4 small"></div>

            <div class="app-form-group mb-4">
                <label asp-for="MaSP" class="form-label fw-semibold">Sản phẩm</label>
                @if (isEditing)
                {
                    <input asp-for="MaSP" type="hidden" />
                    <div class="form-control bg-light"><strong>@Model.MaSP</strong> - @Model.TenSP</div>
                }
                else
                {
                    <select asp-for="MaSP" asp-items="products" class="form-select">
                        <option value="">-- Chọn sản phẩm --</option>
                    </select>
                }
                <span asp-validation-for="MaSP" class="text-danger small"></span>
            </div>

            <div class="d-flex justify-content-between align-items-center gap-3 mb-3">
                <div>
                    <h6 class="fw-bold text-primary mb-1">Danh sách nguyên liệu</h6>
                    <div class="small text-muted">Mỗi nguyên liệu chỉ được chọn một lần. Định lượng phải lớn hơn 0.</div>
                </div>
                <button type="button" class="btn btn-outline-primary rounded-pill" id="add-recipe-row" data-recipe-add>
                    <i class="bi bi-plus-lg"></i> Thêm nguyên liệu
                </button>
            </div>

            <div id="recipe-rows" class="recipe-editor-rows">
                @for (var index = 0; index < Model.Items.Count; index++)
                {
                    <div class="recipe-editor-row">
                        <div class="recipe-row-index">@(index + 1)</div>
                        <div>
                            <label class="form-label small fw-semibold">Nguyên liệu</label>
                            <select asp-for="Items[index].MaNL" class="form-select recipe-ingredient-select">
                                <option value="">-- Chọn nguyên liệu --</option>
                                @foreach (var ingredient in ingredients)
                                {
                                    <option value="@ingredient.MaNL">@ingredient.TenNL (@ingredient.DonViTinh)</option>
                                }
                            </select>
                            <span asp-validation-for="Items[index].MaNL" class="text-danger small"></span>
                        </div>
                        <div>
                            <label class="form-label small fw-semibold">Định lượng</label>
                            <input asp-for="Items[index].DinhLuong" type="number" min="0.001" step="0.001" class="form-control recipe-quantity-input" />
                            <span asp-validation-for="Items[index].DinhLuong" class="text-danger small"></span>
                        </div>
                        <button type="button" class="btn btn-outline-danger recipe-remove-row" data-recipe-remove title="Xóa dòng nguyên liệu">
                            <i class="bi bi-trash3"></i>
                        </button>
                    </div>
                }
            </div>

            <template id="recipe-row-template">
                <div class="recipe-editor-row">
                    <div class="recipe-row-index"></div>
                    <div>
                        <label class="form-label small fw-semibold">Nguyên liệu</label>
                        <select class="form-select recipe-ingredient-select">
                            <option value="">-- Chọn nguyên liệu --</option>
                            @foreach (var ingredient in ingredients)
                            {
                                <option value="@ingredient.MaNL">@ingredient.TenNL (@ingredient.DonViTinh)</option>
                            }
                        </select>
                        <span class="text-danger small recipe-ingredient-validation"></span>
                    </div>
                    <div>
                        <label class="form-label small fw-semibold">Định lượng</label>
                        <input type="number" min="0.001" step="0.001" class="form-control recipe-quantity-input" />
                        <span class="text-danger small recipe-quantity-validation"></span>
                    </div>
                    <button type="button" class="btn btn-outline-danger recipe-remove-row" data-recipe-remove title="Xóa dòng nguyên liệu">
                        <i class="bi bi-trash3"></i>
                    </button>
                </div>
            </template>

            <div class="mt-4 pt-3 border-top d-flex gap-2">
                <button class="btn btn-primary rounded-pill px-5 hover-lift" type="submit">
                    <i class="bi bi-save me-1"></i> @submitLabel
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Hủy bỏ</a>
            </div>
        </form>
    </div>
</div>
