@model object

@{
    var cols = (string[])ViewData["Columns"]!;
    var labels = ViewData["Labels"] as Dictionary<string, string> ?? new();
    var keys = (string[])ViewData["KeyNames"]!;

    string F(object? v, string n)
    {
        if (v == null)
        {
            return "";
        }
        if (v is DateTime d)
        {
            return d.ToString("dd/MM/yyyy HH:mm");
        }
        if (v is decimal m && (n.Contains("Tien") || n.Contains("Gia") || n.Contains("Luong") || n.Contains("Thuong") || n.Contains("Phat") || n.Contains("PhuCap")))
        {
            return m.ToString("N0") + " đ";
        }

        return v.ToString() ?? "";
    }

    IDictionary<string, string> R(object item)
    {
        var r = new Dictionary<string, string>();
        if (keys.Length == 1)
        {
            r["id"] = Convert.ToString(item.GetType().GetProperty(keys[0])?.GetValue(item)) ?? "";
        }
        else
        {
            foreach (var k in keys)
            {
                r[char.ToLowerInvariant(k[0]) + k[1..]] = Convert.ToString(item.GetType().GetProperty(k)?.GetValue(item)) ?? "";
            }
        }

        return r;
    }
}

<!-- PAGE HEADER -->
<div class="page-header">
    <div class="page-title-group">
        <h2>@ViewData["Title"]</h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Tổng quan</a></li>
                <li class="breadcrumb-item"><a asp-action="Index">Lương nhân viên</a></li>
                <li class="breadcrumb-item active" aria-current="page">Chi tiết</li>
            </ol>
        </nav>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-all-route-data="R(Model)" class="btn btn-primary rounded-pill px-4 hover-lift">
            <i class="bi bi-pencil-square me-1"></i> Chỉnh sửa
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
            <i class="bi bi-arrow-left"></i> Quay lại
        </a>
    </div>
</div>

<!-- DETAILS CARD -->
<div class="card app-card mb-4 border-primary">
    <div class="app-card-header bg-primary text-white">
        <h5 class="mb-0 fw-bold text-white"><i class="bi bi-info-circle-fill me-2"></i> Chi tiết phiếu lương</h5>
    </div>
    <div class="app-card-body p-4">
        <div class="bg-light rounded-3 p-4 border">
            <div class="row g-3">
                @foreach (var c in cols)
                {
                    var val = Model.GetType().GetProperty(c)?.GetValue(Model);
                    var labelText = labels.ContainsKey(c) ? labels[c] : c;
                    
                    <div class="col-12 col-md-6 border-bottom pb-2">
                        <div class="text-muted small fw-bold text-uppercase mb-1">@labelText:</div>
                        @if (c == "MaLuong" || c == "MaNV")
                        {
                            <code class="fw-bold fs-6">@F(val, c)</code>
                        }
                        else if (c.Contains("Tien") || c.Contains("Luong") || c.Contains("Thuong") || c.Contains("Phat") || c.Contains("PhuCap"))
                        {
                            var isNegative = c.Contains("Phat");
                            <span class="fw-bold fs-5 @(isNegative ? "text-danger" : "text-success")">@F(val, c)</span>
                        }
                        else
                        {
                            <span class="fw-semibold text-dark fs-6">@F(val, c)</span>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>
