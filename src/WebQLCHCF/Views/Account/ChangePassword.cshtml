@model ChangePasswordViewModel

@{
    ViewData["Title"] = "Đổi mật khẩu";
}

<div class="page-header">
    <div class="page-title-group">
        <h2>@ViewData["Title"]</h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Order" asp-action="Create">Order</a></li>
                <li class="breadcrumb-item active" aria-current="page">Đổi mật khẩu</li>
            </ol>
        </nav>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="card app-card form-card">
            <div class="app-card-header bg-primary text-white">
                <h5 class="mb-0 fw-bold text-white">
                    <i class="bi bi-key-fill me-2"></i> Cập nhật mật khẩu tài khoản
                </h5>
            </div>
            <div class="app-card-body p-4">
                <form asp-action="ChangePassword" method="post" class="needs-validation" novalidate data-no-pjax>
                    @Html.AntiForgeryToken()

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div asp-validation-summary="All" class="alert alert-danger border-0 rounded-3 mb-4 small"></div>
                    }

                    <div class="app-form-group mb-3">
                        <label asp-for="MatKhauHienTai" class="form-label fw-semibold">Mật khẩu hiện tại</label>
                        <input asp-for="MatKhauHienTai" class="form-control" autocomplete="current-password" />
                        <span asp-validation-for="MatKhauHienTai" class="text-danger small"></span>
                    </div>

                    <div class="app-form-group mb-3">
                        <label asp-for="MatKhauMoi" class="form-label fw-semibold">Mật khẩu mới</label>
                        <input asp-for="MatKhauMoi" class="form-control" autocomplete="new-password" />
                        <div class="form-text">Tối thiểu 8 ký tự, có số, có ký tự đặc biệt và không trùng tên đăng nhập.</div>
                        <span asp-validation-for="MatKhauMoi" class="text-danger small"></span>
                    </div>

                    <div class="app-form-group mb-4">
                        <label asp-for="XacNhanMatKhauMoi" class="form-label fw-semibold">Xác nhận mật khẩu mới</label>
                        <input asp-for="XacNhanMatKhauMoi" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="XacNhanMatKhauMoi" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button class="btn btn-primary rounded-pill px-5" type="submit">
                            <i class="bi bi-save me-1"></i> Đổi mật khẩu
                        </button>
                        <a asp-controller="Order" asp-action="Create" class="btn btn-outline-secondary rounded-pill px-4">Hủy bỏ</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
