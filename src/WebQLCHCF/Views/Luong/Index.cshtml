@model IEnumerable<object>

@{
    var cols = (string[])ViewData["Columns"]!;
    var labels = ViewData["Labels"] as Dictionary<string, string> ?? new();
    var keys = (string[])ViewData["KeyNames"]!;

    string F(object? v, string n)
    {
        if (v == null)
        {
            return "";
        }
        if (v is DateTime d)
        {
            return d.ToString("dd/MM/yyyy");
        }
        if (v is decimal m && (n.Contains("Tien") || n.Contains("Gia") || n.Contains("Luong") || n.Contains("Thuong") || n.Contains("Phat") || n.Contains("PhuCap")))
        {
            return m.ToString("N0") + " đ";
        }

        return v.ToString() ?? "";
    }

    IDictionary<string, string> R(object item)
    {
        var r = new Dictionary<string, string>();
        if (keys.Length == 1)
        {
            r["id"] = Convert.ToString(item.GetType().GetProperty(keys[0])?.GetValue(item)) ?? "";
        }
        else
        {
            foreach (var k in keys)
            {
                r[char.ToLowerInvariant(k[0]) + k[1..]] = Convert.ToString(item.GetType().GetProperty(k)?.GetValue(item)) ?? "";
            }
        }

        return r;
    }
}

<!-- PAGE HEADER -->
<div class="page-header">
    <div class="page-title-group">
        <h2>@ViewData["Title"]</h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Tổng quan</a></li>
                <li class="breadcrumb-item active" aria-current="page">Lương nhân viên</li>
            </ol>
        </nav>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Thang" class="btn btn-outline-primary rounded-pill px-4 d-flex align-items-center gap-1.5">
            <i class="bi bi-calendar3"></i> Lương tháng
        </a>
        <a asp-action="Create" class="btn btn-primary rounded-pill px-4 hover-lift d-flex align-items-center gap-1.5">
            <i class="bi bi-plus-lg"></i> Thêm mới
        </a>
    </div>
</div>

<!-- DATA CARD -->
<div class="card app-card">
    <div class="app-card-body p-0">
        <div class="table-responsive">
            <table class="table app-table align-middle mb-0">
                <thead>
                    <tr>
                        @foreach (var c in cols)
                        {
                            <th>@(labels.ContainsKey(c) ? labels[c] : c)</th>
                        }
                        <th class="text-end" style="width: 200px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="@(cols.Length + 1)" class="text-center py-5 text-muted">
                                <i class="bi bi-cash-stack fs-1 d-block mb-2 text-secondary"></i>
                                Không tìm thấy dữ liệu bảng lương nào!
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                @foreach (var c in cols)
                                {
                                    var val = item.GetType().GetProperty(c)?.GetValue(item);
                                    if (c == "MaLuong" || c == "MaNV")
                                    {
                                        <td><code>@F(val, c)</code></td>
                                    }
                                    else if (c.Contains("Tien") || c.Contains("Luong") || c.Contains("Thuong") || c.Contains("Phat") || c.Contains("PhuCap"))
                                    {
                                        var isNegative = c.Contains("Phat");
                                        <td class="fw-bold @(isNegative ? "text-danger" : "text-success")">@F(val, c)</td>
                                    }
                                    else
                                    {
                                        <td>@F(val, c)</td>
                                    }
                                }
                                <td class="text-end text-nowrap">
                                    <div class="d-inline-flex gap-1.5">
                                        <a asp-action="Details" asp-all-route-data="R(item)" class="btn btn-sm btn-outline-secondary rounded-pill px-2.5 py-1" title="Chi tiết">
                                            <i class="bi bi-eye"></i> Chi tiết
                                        </a>
                                        <a asp-action="Edit" asp-all-route-data="R(item)" class="btn btn-sm btn-outline-primary rounded-pill px-2.5 py-1" title="Sửa">
                                            <i class="bi bi-pencil-square"></i> Sửa
                                        </a>
                                        <a asp-action="Delete" asp-all-route-data="R(item)" class="btn btn-sm btn-outline-danger rounded-pill px-2.5 py-1" title="Xóa">
                                            <i class="bi bi-trash"></i> Xóa
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
