@model IEnumerable<object>

@{
    ViewData["Title"] = "Quản lý Bàn";
    var cols = (string[])ViewData["Columns"]!;
    var labels = ViewData["Labels"] as Dictionary<string, string> ?? new();
    var keys = (string[])ViewData["KeyNames"]!;

    string F(object? v, string n)
    {
        if (v == null)
        {
            return "";
        }
        if (v is DateTime d)
        {
            return d.ToString("dd/MM/yyyy");
        }
        if (v is decimal m && (n.Contains("Tien") || n.Contains("Gia") || n.Contains("Luong")))
        {
            return m.ToString("N0") + " đ";
        }

        return v.ToString() ?? "";
    }

    string GetBadgeClass(string value)
    {
        return value switch
        {
            "Đang bán" or "Trống" or "Sẵn sàng" => "badge-success-subtle",
            "Tạm ngưng" or "Cảnh báo" => "badge-warning-subtle",
            "Ngừng bán" or "Đang phục vụ" => "badge-primary-subtle",
            "Khóa" or "Hủy" or "Đã xóa" => "badge-danger-subtle",
            _ => "badge-info-subtle"
        };
    }

    bool IsOnline(string value) => value == "Đang phục vụ";

    IDictionary<string, string> R(object item)
    {
        var r = new Dictionary<string, string>();
        if (keys.Length == 1)
        {
            r["id"] = Convert.ToString(item.GetType().GetProperty(keys[0])?.GetValue(item)) ?? "";
        }
        else
        {
            foreach (var k in keys)
            {
                r[char.ToLowerInvariant(k[0]) + k[1..]] = Convert.ToString(item.GetType().GetProperty(k)?.GetValue(item)) ?? "";
            }
        }

        return r;
    }
}

<!-- PAGE HEADER -->
<div class="page-header">
    <div class="page-title-group">
        <h2>@ViewData["Title"]</h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Tổng quan</a></li>
                <li class="breadcrumb-item active" aria-current="page">Bàn phục vụ</li>
            </ol>
        </nav>
    </div>
    <a asp-action="Create" class="btn btn-primary rounded-pill px-4 d-flex align-items-center gap-2 hover-lift">
        <i class="bi bi-plus-lg"></i>
        <span>Thêm bàn mới</span>
    </a>
</div>

<!-- PREMIUM TABLE CARD -->
<div class="card app-card">
    <div class="app-card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0 fw-bold text-primary"><i class="bi bi-grid-3x3-gap-fill me-2"></i> Danh sách bàn ăn / Bàn phục vụ</h5>
        <span class="badge badge-primary-subtle py-2 px-3">Tổng số: @Model.Count() bàn</span>
    </div>
    <div class="app-card-body p-0">
        <div class="table-responsive border-0 rounded-0">
            <table class="table app-table align-middle mb-0 ban-table">
                <thead>
                    <tr>
                        @foreach (var c in cols)
                        {
                            <th>@(labels.ContainsKey(c) ? labels[c] : c)</th>
                        }
                        <th class="text-center" style="width: 180px;">Hoạt động</th>
                        <th class="text-end ban-actions-header">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="@(cols.Length + 2)" class="text-center py-5 text-muted">
                                <i class="bi bi-folder-x fs-1 d-block mb-2"></i>
                                Không tìm thấy bàn nào trong hệ thống!
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            var maBan = Convert.ToString(item.GetType().GetProperty("MaBan")?.GetValue(item)) ?? "";
                            var tenBan = Convert.ToString(item.GetType().GetProperty("TenBan")?.GetValue(item)) ?? "";
                            var trangThai = Convert.ToString(item.GetType().GetProperty("TrangThai")?.GetValue(item)) ?? "";
                            var isMangVe = string.Equals(maBan, "MVE", StringComparison.OrdinalIgnoreCase);
                            var isOnline = IsOnline(trangThai);
                            <tr>
                                @foreach (var c in cols)
                                {
                                    var value = F(item.GetType().GetProperty(c)?.GetValue(item), c);
                                    <td>
                                        @if (c == "TrangThai" || c == "TinhTrang")
                                        {
                                            <span class="badge @GetBadgeClass(value)">@value</span>
                                        }
                                        else if (c == "MaBan" || c == "MVE")
                                        {
                                            <code class="fw-bold">@value</code>
                                        }
                                        else
                                        {
                                            @value
                                        }
                                    </td>
                                }
                                <td class="text-center text-nowrap">
                                    @if (isMangVe)
                                    {
                                        <span class="badge badge-info-subtle align-self-center py-2 px-3">Mang về</span>
                                    }
                                    else if (trangThai == "Trống")
                                    {
                                        <span class="table-switch table-switch-off" title="Trống = bàn trống, có thể nhận khách">
                                            <span class="table-switch-dot"></span>
                                            Trống
                                        </span>
                                    }
                                    else if (isOnline)
                                    {
                                        <form asp-action="CustomerLeaves" method="post" class="d-inline" data-no-pjax="true"
                                              onsubmit="return confirm('Xác nhận khách đã đi và chuyển bàn này về Trống?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="maBan" value="@maBan" />
                                            <button type="submit" class="table-switch table-switch-online table-switch-button border-0" title="Đang phục vụ = bàn đang có khách. Bấm để chuyển về Trống.">
                                                <span class="table-switch-dot"></span>
                                                Đang phục vụ
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="table-switch table-switch-disabled" title="Trạng thái bàn chưa thuộc luồng sử dụng chính">
                                            <span class="table-switch-dot"></span>
                                            --
                                        </span>
                                    }
                                </td>
                                <td class="text-end text-nowrap ban-actions-cell">
                                    <div class="ban-actions-group">
                                        @if (!isMangVe && trangThai != "Trống")
                                        {
                                            <form asp-action="Restore" method="post" class="d-inline" data-no-pjax="true"
                                                  onsubmit="return confirm('Xác nhận khách đã về và khôi phục ' + @Html.Raw(System.Text.Json.JsonSerializer.Serialize(tenBan)) + ' về trạng thái Trống?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="maBan" value="@maBan" />
                                                <button type="submit" class="btn btn-sm btn-outline-success rounded-pill px-2.5 py-1" title="Khách về - Bấm nhanh khôi phục => bàn trống">
                                                    <i class="bi bi-arrow-repeat"></i> <span class="d-none d-xl-inline">Khôi phục</span>
                                                </button>
                                            </form>
                                        }
                                        <a asp-action="Details" asp-all-route-data="R(item)" class="btn btn-sm btn-outline-secondary rounded-pill px-2.5 py-1" title="Chi tiết">
                                            <i class="bi bi-eye-fill"></i> <span class="d-none d-xl-inline">Chi tiết</span>
                                        </a>
                                        @if (!isMangVe)
                                        {
                                            <a asp-action="Edit" asp-all-route-data="R(item)" class="btn btn-sm btn-outline-primary rounded-pill px-2.5 py-1" title="Sửa">
                                                <i class="bi bi-pencil-square"></i> <span class="d-none d-xl-inline">Sửa</span>
                                            </a>
                                            <a asp-action="Delete" asp-all-route-data="R(item)" class="btn btn-sm btn-outline-danger rounded-pill px-2.5 py-1" title="Xóa">
                                                <i class="bi bi-trash-fill"></i> <span class="d-none d-xl-inline">Xóa</span>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
