@model LoginViewModel

@{
    Layout = null;
    ViewData["Title"] = "Đăng nhập";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng nhập - WebQLCHCF Premium Cafe</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="login-body">

    <div class="login-card">
        <div class="login-logo">
            <i class="bi bi-cup-hot-fill text-warning display-4 mb-2 d-inline-block"></i>
            <h4 class="mb-1 fw-bold tracking-tight">QLCHCF PREMIUM</h4>
            <p class="mb-0 text-muted small" style="color: rgba(240, 230, 223, 0.6) !important;">Hệ thống quản lý quán cà phê hiện đại</p>
        </div>
        
        <div class="login-form-wrap">
            <h5 class="fw-bold mb-4 text-center text-primary">ĐĂNG NHẬP HỆ THỐNG</h5>
            
            <form asp-action="Login" method="post">
                @Html.AntiForgeryToken()

                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success py-2 px-3 rounded-3 mb-3 small d-flex align-items-start gap-2 border-0 shadow-sm">
                        <i class="bi bi-check-circle-fill"></i>
                        <div>@TempData["Success"]</div>
                    </div>
                }
                
                @if (ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                {
                    <div class="alert alert-danger py-2 px-3 rounded-3 mb-3 small d-flex align-items-start gap-2 border-0 shadow-sm">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <div asp-validation-summary="ModelOnly" class="mb-0"></div>
                    </div>
                }

                <div class="app-form-group mb-3">
                    <label asp-for="TenDangNhap" class="form-label fw-semibold">Tên đăng nhập</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-person-fill"></i></span>
                        <input asp-for="TenDangNhap" class="form-control border-start-0 ps-1" placeholder="Nhập tài khoản..." autofocus />
                    </div>
                    <span asp-validation-for="TenDangNhap" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="app-form-group mb-4">
                    <label asp-for="MatKhau" class="form-label fw-semibold">Mật khẩu</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-key-fill"></i></span>
                        <input asp-for="MatKhau" type="password" class="form-control border-start-0 border-end-0 ps-1" placeholder="Nhập mật khẩu..." autocomplete="current-password" id="login-password" />
                        <button class="input-group-text bg-white border-start-0 text-muted password-toggle-btn" type="button" id="toggle-login-password" aria-label="Hiện mật khẩu" aria-pressed="false">
                            <i class="bi bi-eye-fill" aria-hidden="true"></i>
                        </button>
                    </div>
                    <span asp-validation-for="MatKhau" class="text-danger small mt-1 d-block"></span>
                </div>

                <button class="btn btn-primary w-100 py-2.5 fw-bold rounded-3 shadow-sm d-flex align-items-center justify-content-center gap-2 hover-lift" type="submit">
                    <i class="bi bi-box-arrow-in-right"></i> Đăng nhập hệ thống
                </button>
            </form>
            
            <div class="mt-4 text-center">
                <small class="text-muted">Hỗ trợ kỹ thuật: <strong class="text-primary">090xxxxxxx</strong></small>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const passwordInput = document.getElementById('login-password');
            const toggleButton = document.getElementById('toggle-login-password');

            if (!passwordInput || !toggleButton) {
                return;
            }

            const icon = toggleButton.querySelector('i');

            toggleButton.addEventListener('click', function () {
                const shouldShowPassword = passwordInput.type === 'password';
                passwordInput.type = shouldShowPassword ? 'text' : 'password';
                toggleButton.setAttribute('aria-pressed', shouldShowPassword.toString());
                toggleButton.setAttribute('aria-label', shouldShowPassword ? 'Ẩn mật khẩu' : 'Hiện mật khẩu');

                if (icon) {
                    icon.classList.toggle('bi-eye-fill', !shouldShowPassword);
                    icon.classList.toggle('bi-eye-slash-fill', shouldShowPassword);
                }
            });
        });
    </script>
</body>
</html>
